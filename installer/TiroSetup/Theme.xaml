<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tiro identity: ink surfaces, parchment text, Tyrian violet -> rose -> ember -->
    <Color x:Key="Ink950">#0B0A10</Color>
    <Color x:Key="Ink900">#121119</Color>
    <Color x:Key="Ink850">#17151F</Color>
    <Color x:Key="Ink800">#1E1B28</Color>
    <Color x:Key="Ink750">#252231</Color>
    <Color x:Key="Ink700">#2E2A3B</Color>
    <Color x:Key="TextColor">#F2EDE4</Color>
    <Color x:Key="Text2Color">#A9A2B6</Color>
    <Color x:Key="Text3Color">#6F6980</Color>
    <Color x:Key="Tyrian">#8B5CF6</Color>
    <Color x:Key="Rose">#E6508E</Color>
    <Color x:Key="Ember">#FF8A4C</Color>
    <Color x:Key="OkColor">#5CD6A2</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>

    <SolidColorBrush x:Key="Ink950Brush" Color="{StaticResource Ink950}" />
    <SolidColorBrush x:Key="Ink900Brush" Color="{StaticResource Ink900}" />
    <SolidColorBrush x:Key="Ink850Brush" Color="{StaticResource Ink850}" />
    <SolidColorBrush x:Key="Ink800Brush" Color="{StaticResource Ink800}" />
    <SolidColorBrush x:Key="Ink750Brush" Color="{StaticResource Ink750}" />
    <SolidColorBrush x:Key="Ink700Brush" Color="{StaticResource Ink700}" />
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource Rose}" />
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource Ember}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Tyrian}" Offset="0" />
        <GradientStop Color="{StaticResource Rose}" Offset="0.55" />
        <GradientStop Color="{StaticResource Ember}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradientDiag" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="{StaticResource Tyrian}" Offset="0" />
        <GradientStop Color="{StaticResource Rose}" Offset="0.55" />
        <GradientStop Color="{StaticResource Ember}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#1A1724" Offset="0" />
        <GradientStop Color="#110F17" Offset="0.55" />
        <GradientStop Color="#0E0D13" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#55E6508E" Offset="0" />
        <GradientStop Color="#00E6508E" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="Inter">pack://application:,,,/Fonts/#Inter</FontFamily>

    <!-- text -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="21" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <!-- buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="24,11" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="glow" CornerRadius="11" Background="{StaticResource BrandGradient}" Opacity="0.0" Margin="-2">
                            <Border.Effect><BlurEffect Radius="16" /></Border.Effect>
                        </Border>
                        <Border CornerRadius="10" Background="{StaticResource BrandGradient}" />
                        <Border x:Name="sheen" CornerRadius="10" Background="White" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="sheen" Property="Opacity" Value="0.08" />
                            <Setter TargetName="glow" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="10" Background="{StaticResource Ink800Brush}"
                            BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Ink750Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Ink750Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Ink850Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- a big selectable option ("GPU acceleration" / "CPU only") -->
    <Style x:Key="SetupCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="16" BorderThickness="2" Padding="0"
                                BorderBrush="{StaticResource BrandGradientDiag}" Opacity="0" />
                        <Border x:Name="card" Margin="2" CornerRadius="14" Background="{StaticResource Ink850Brush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20,18">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{StaticResource Ink800Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1" />
                            <Setter TargetName="card" Property="Background" Value="#1D1A27" />
                            <Setter TargetName="card" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="card" Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- segmented choice (language) -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg" CornerRadius="8" Padding="14,7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Ink700Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- switch-style checkbox -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="22" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="11" Background="{StaticResource Ink700Brush}" />
                            <Border x:Name="on" CornerRadius="11" Background="{StaticResource BrandGradient}" Opacity="0" />
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="slide" X="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- gradient progress bar -->
    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{StaticResource Ink700Brush}" />
                        <Border x:Name="PART_Indicator" CornerRadius="4" Background="{StaticResource BrandGradient}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small badge ("RECOMMENDED") -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{StaticResource BrandGradient}" />
    </Style>
</ResourceDictionary>
